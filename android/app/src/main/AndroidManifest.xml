<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reminders: exact alarms so a check-in nudge fires on time even with the app closed.
         Only SCHEDULE_EXACT_ALARM is declared: Android docs are explicit that only one of
         SCHEDULE_EXACT_ALARM or USE_EXACT_ALARM should be requested, and USE_EXACT_ALARM is
         a restricted permission reserved for apps whose core function is an alarm clock,
         timer, or calendar app — forgetmenot doesn't qualify, so it also doesn't declare it.

         Declaring it here only makes it requestable, though: since this app targets SDK 36,
         Android 14+ denies SCHEDULE_EXACT_ALARM by default on fresh installs, with no runtime
         popup for it the way POST_NOTIFICATIONS gets one. reminders/ExactAlarms.kt checks
         canScheduleExactAlarms(), and the app's own Settings row (ui/screens/settings/
         SettingsPlatform.kt) opens ACTION_REQUEST_SCHEDULE_EXACT_ALARM, the one system toggle
         that grants it, instead of leaving reminders silently late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Import from contacts, one or several (integrations/ContactsSource.kt), asked for at
         the moment of import. Read only: the app never writes a contact, so WRITE_CONTACTS is
         not declared (the web build's contacts plugin needed it only for its permission alias).
         The avatar comes from the system Photo Picker, which needs no storage permission. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- No android.permission.INTERNET: fonts are bundled (res/font) and every outbound
         link (sms:/mailto:, wa.me, t.me and signal.me for the messaging apps, the calendar
         app, a share-sheet target for the vCard or the .ics fallback) is handed to another
         app with an implicit intent (integrations/ShareIntents.kt), not fetched by this app. Without this permission the app is physically
         incapable of making a network connection. -->

    <!-- "Plan something" hands event creation off to whatever calendar app is installed
         with an ACTION_INSERT intent (DeviceIntegrations.plan()) rather than writing to the
         calendar provider, so it needs no READ_CALENDAR/WRITE_CALENDAR permission at all:
         this app never touches calendar data itself. startActivity() does not need package
         visibility, but minSdk is 30, so these <queries> keep the calendar app and the share
         targets visible to any resolveActivity()/queryIntentActivities() check. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
        <!-- "Share" on the friend detail screen opens Android's chooser with the friend's
             vCard as plain text (DeviceIntegrations.share(), domain/Share.kt buildVCard). -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- The .ics fallback (writeShareFile() + fileShareIntent()) shared when no calendar
             app took the ACTION_INSERT intent above. Its own entry, because <queries>
             visibility is matched per action+mimeType pair. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/calendar" />
        </intent>
    </queries>

    <!-- allowBackup=false: the friend data lives in the user-picked SAF sync folder, but
         its URI grant, the reminder plan, the widget summaries and the shared .ics in the
         cache live in this app's private storage, and none of it should reach Google Drive's Auto Backup or an
         adb backup. The only copy outside the device is the one the user's own sync makes,
         so no copy of this data should exist anywhere the user didn't put it. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:name=".MainActivity"
            android:theme="@style/AppTheme.NoActionBarLaunch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Backs writeShareFile() (integrations/ShareIntents.kt): the only thing this app
             uses a FileProvider for is handing a generated .ics invite to another app via a
             content:// URI when no calendar app claimed the ACTION_INSERT intent above. android:exported must be false and grantUriPermissions true;
             file_paths.xml scopes it to a single cache subfolder, nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Reminders (reminders/): posts a nudge when its alarm fires and handles its buttons
             (Logged it / Next week / Wished them). Only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Re-arms the saved reminder plan after a reboot (RECEIVE_BOOT_COMPLETED), and on
             MY_PACKAGE_REPLACED rebuilds the schedule before the updated app is first
             opened, and the exact-alarm grant rebuilds it so reminders turn exact at once.
             It must be exported for the system to deliver these; a forged one only causes a
             harmless rebuild. -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Widget 1: single most-needs-attention friend -->
        <receiver
            android:name=".widget.SpotlightWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_spotlight_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spotlight_info" />
        </receiver>

        <!-- Widget 2: top-3 list -->
        <receiver
            android:name=".widget.TopThreeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_topthree_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_topthree_info" />
        </receiver>

        <!-- Widget 3: weighted-random spotlight -->
        <receiver
            android:name=".widget.RandomWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_random_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_random_info" />
        </receiver>

    </application>

</manifest>
